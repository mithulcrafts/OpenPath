PORT=4173
HOST=127.0.0.1
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Set a token before exposing this service publicly. The server shows a login page.
APP_ACCESS_TOKEN=
# Exact trusted proxy addresses/CIDRs, e.g. loopback for a local HTTPS proxy.
# Leave empty for direct local access; forwarded headers are then ignored.
TRUST_PROXY=
# Optional comma-separated public hostnames. Empty means any public HTTP(S) site.
AUDIT_ALLOWED_HOSTS=
MAX_AUDIT_PAGES=4
MODEL_TIMEOUT_MS=30000
OPENPATH_DATA_DIR=data
# Set to true only for hosted installations that need Chromium's container fallback.
CHROMIUM_NO_SANDBOX=false
OPENPATH_DEMO_MODE=true
# Set false for strictly credit-free local verification, even if a key exists.
OPENPATH_AI_ENABLED=true
