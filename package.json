{
  "name": "openpath-agent-readiness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore ./data server/index.ts",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "start": "node --import ./scripts/production.mjs dist/server/index.js",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "tsx --test test/browser.integration.ts",
    "test:e2e": "playwright test",
    "browser:install": "node scripts/install-browser.mjs"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.65.0",
    "openai": "7.45.1",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
